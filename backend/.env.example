# ============================================
# DiDi-Sicuani Backend - Variables de Entorno
# ============================================
#
# INSTRUCCIONES:
# 1. Copia este archivo como .env en la misma carpeta
# 2. Reemplaza los valores de ejemplo con tus credenciales reales
# 3. NO subas el archivo .env a Git (está en .gitignore)
#
# Para producción (cPanel):
# - Cambia NODE_ENV=production
# - Cambia PORT=10000 (o el puerto asignado por cPanel)
# - Actualiza las URLs de CORS con tu dominio real
# ============================================

# ========== SERVIDOR ==========
# development | production
NODE_ENV=development

# Puerto del servidor
# Desarrollo: 5000
# Producción (cPanel): 10000 (o el asignado por cPanel)
PORT=5000

# ========== MONGODB ATLAS ==========
# Connection string de MongoDB Atlas
# Formato: mongodb+srv://usuario:password@cluster.xxxxx.mongodb.net/didi-sicuani?retryWrites=true&w=majority
#
# Ejemplo:
# MONGODB_URI=mongodb+srv://didi-sicuani:TU_PASSWORD@cluster0.xxxxx.mongodb.net/didi-sicuani?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/didi-sicuani?retryWrites=true&w=majority

# ========== REDIS CLOUD ==========
# Opción 1: Usar URL completa (RECOMENDADO para Redis Cloud)
# Formato: redis://default:password@host:port
#
# Ejemplo:
# REDIS_URL=redis://default:TU_PASSWORD@redis-xxxxx.crce216.sa-east-1-2.ec2.cloud.redislabs.com:18779
REDIS_URL=redis://default:password@redis-xxxxx.crce216.sa-east-1-2.ec2.cloud.redislabs.com:18779

# Opción 2: Usar variables separadas (alternativa)
# Descomenta estas líneas si prefieres usar variables separadas en lugar de REDIS_URL
# REDIS_HOST=redis-xxxxx.crce216.sa-east-1-2.ec2.cloud.redislabs.com
# REDIS_PORT=18779
# REDIS_PASSWORD=tu_password_redis

# ========== POSTGRESQL + POSTGIS ==========
# (Opcional - Solo si usas PostgreSQL para datos geoespaciales)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=sicuani_geo
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

# ========== JWT (JSON Web Token) ==========
# Clave secreta para firmar los tokens JWT
# IMPORTANTE: Genera una clave segura y única para producción
# Mínimo recomendado: 32 caracteres
#
# Generar clave segura:
# Windows (PowerShell): -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 64 | ForEach-Object {[char]$_})
# Linux/Mac: openssl rand -base64 64
# Node.js: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=tu_jwt_secret_super_seguro_cambiar_en_produccion_minimo_32_caracteres

# Tiempo de expiración del token JWT
# Formatos: 1h, 24h, 7d, 30d, etc.
JWT_EXPIRES_IN=7d

# ========== SOCKET.IO Y CORS ==========
# URL del frontend para permitir conexiones CORS y Socket.io
#
# Desarrollo:
# SOCKET_CORS_ORIGIN=http://localhost:5173
# CORS_ORIGIN=http://localhost:5173
#
# Producción (cPanel):
# SOCKET_CORS_ORIGIN=https://tu-dominio.com
# CORS_ORIGIN=https://tu-dominio.com
#
# Si tienes múltiples orígenes, sepáralos por comas:
# CORS_ORIGIN=https://tu-dominio.com,https://www.tu-dominio.com
SOCKET_CORS_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ========== RATE LIMITING ==========
# Configuración de límite de peticiones
# RATE_LIMIT_WINDOW_MS: Ventana de tiempo en milisegundos (ej: 900000 = 15 minutos)
# RATE_LIMIT_MAX_REQUESTS: Máximo de peticiones en la ventana de tiempo
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100